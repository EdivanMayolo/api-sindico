{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "front",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "../front-sindico",
        "run",
        "dev"
      ],
      "port": 9000
    },
    {
      "name": "front-teste",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "set API_URL=http://localhost:3999&& npm --prefix ../front-sindico run dev -- --port 9001"
      ],
      "port": 9001
    }
  ]
}
